{
  "name": "stoutlogic/acf-builder",
  "description": "An Advanced Custom Field Configuration Builder",
  "require": {
    "php": ">=8.2.0",
    "doctrine/inflector": "^2.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "dms/phpunit-arraysubset-asserts": "^0.5.0",
    "phpdocumentor/reflection-docblock": "6.*",
    "phpspec/prophecy-phpunit": "^2.0.1",
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^10.0 || ^11",
    "rector/rector": "^2.0",
    "squizlabs/php_codesniffer": "^3.13.5 || ^4.0",
    "timber/teak": "^1.4",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "license": "GPL-2.0+",
  "authors": [
    {
      "name": "Steve Pfisterer",
      "email": "steve@stoutlogic.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "StoutLogic\\AcfBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StoutLogic\\AcfBuilder\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "docs:classes": "vendor/bin/teak generate:class-reference ./src/ --output ./docs/reference",
    "test:no-deprecation": "@php -d 'error_reporting=E_ALL&~E_DEPRECATED' vendor/bin/phpunit",
    "rector": "rector process --dry-run",
    "rector:fix": "rector process",
    "cs": "phpcs",
    "cs:fix": "phpcbf"
  }
}
